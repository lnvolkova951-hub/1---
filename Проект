ГруппаРиска = ВвестиЧисло("Укажите количество людей в группе риска: ");
Если ГруппаРиска = "" Тогда
    Сообщить("Ошибка: не указано число");
ИначеЕсли Не ЯвляетсяЧислом(ГруппаРиска) Тогда
    Сообщить("Ошибка: введено не число");
ИначеЕсли ГруппаРиска < 0 Тогда
    Сообщить("Ошибка: данное число не может быть отрицательным");
    Возврат;
КонецЕсли;

Привит = ВвестиЧисло("Введите количество привитых ранее: ");
Если Привит = "" ИЛИ Привит < 0 ИЛИ Не ЯвляетсяЧислом(Привит) Тогда
    Сообщить("Будьте внимательны, введите число привитых!");
    Возврат;
КонецЕсли;

Отказ = ВвестиЧисло("Введите число отказавшихся: ");
Если Отказ = "" ИЛИ Отказ < 0 ИЛИ Не ЯвляетсяЧислом(Отказ) Тогда
    Сообщить("Будьте внимательны, укажите число отказавшихся");
    Возврат;
КонецЕсли;

Выполн = ГруппаРиска - Привит - Отказ;
ПолнВып = Выполн * 0,3;
НеполнВып = Выполн - ПолнВып;
ПроцВыполн = Выполн / (ГруппаРиска / 100);

Если Выполн < 0 Тогда
    Сообщить("Ошибка: отрицательный результат. Проверьте корректность введенных данных.");
    Возврат;
КонецЕсли;

Сообщить(Выполн);
Сообщить(ПроцВыполн);
Сообщить(ПолнВып);
Сообщить(НеполнВып);
